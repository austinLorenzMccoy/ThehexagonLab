# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=

# Edge Functions (optional)
SLACK_WEBHOOK_URL=
NOTIFICATION_EMAIL=

# Field-level encryption for sensitive columns (e.g. app_users.paystack_recipient_code).
# Any long random string — used to derive an AES-256 key. Required in production.
FIELD_ENCRYPTION_KEY=

# Paystack — powers Mark Paid on Pay Slips, Referrals & Payouts.
# See doc/paystack_integration_guide.md for full setup steps.
PAYSTACK_SECRET_KEY=
